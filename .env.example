# ---- Required ----
POSTGRES_PASSWORD=change-me-to-a-long-random-string
NODE_ENV=production
COOKIE_SECURE=true          # keep true when served over HTTPS

# ---- Optional ----
DEMO_MODE=false             # true ONLY on a separate demo database
MAX_UPLOAD_MB=5
SESSION_DAYS=7
BACKUP_KEEP_DAYS=30
# REPORT_CRON="0 18 * * *"  # 6:00 PM IST (default)
# REMINDER_CRON="30 9 * * *"

# ---- WhatsApp Cloud API (server-side only; never put these in the frontend) ----
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=     # an APPROVED utility template with one body variable {{1}}
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0
